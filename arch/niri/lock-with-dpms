#!/bin/sh
# Keep DPMS handling scoped to an active Hyprlock session.
set -eu

cleanup() {
    kill "${idle_pid:-}" 2>/dev/null || true
}

trap cleanup EXIT HUP INT TERM

swayidle -w \
    timeout 90 'niri msg action power-off-monitors' \
    resume 'niri msg action power-on-monitors' &
idle_pid=$!

hyprlock
